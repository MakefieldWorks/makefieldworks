---
import Workshop from '../layouts/Workshop.astro';

const products = [
  {
    name: 'FERSCalc',
    job: 'Compare two federal retirement dates and see how another year on the job changes the picture. Explore how your pension, TSP withdrawals, and Social Security fit together.',
    url: 'https://ferscalc.com/',
    accent: 'var(--mw-product-ferscalc)',
  },
  {
    name: 'Visual Passage Planner',
    job: 'Lay out an ocean passage and explore the winds, currents, and waves typical for each month. Compare departure months along the same route.',
    url: 'https://www.digwave.com/',
    accent: 'var(--mw-product-vpp)',
  },
  {
    name: 'NautiCalc',
    job: 'Run the everyday numbers for a day on the water. Estimate arrival time at a given speed, check fuel range, or work out how much anchor line to let out.',
    url: 'https://www.nauticalc.com/',
    accent: 'var(--mw-product-nauticalc)',
  },
  {
    name: 'Statekeep',
    job: 'Keep a record of how equipment is configured. Compare two named snapshots to see which components moved, what was added, and which settings changed.',
    url: 'https://statekeep.app/',
    accent: 'var(--mw-product-manifest)',
  },
  {
    name: 'The Grunting Gardener',
    job: 'Keep a garden notebook with friends. Post a photo, ask what worked in someone else’s bed, and find that answer again when planting time comes around.',
    url: 'https://thegruntinggardener.com/',
    accent: 'var(--mw-product-gardener)',
  },
];
---
<Workshop>
  <div class="spread" id="top">
    <section aria-labelledby="intro">
      <p class="location">Upper Makefield Township, Pennsylvania, United States</p>
      <h1 id="intro">A one-person software workshop.</h1>
      <p class="lead">The workshop’s first tool helped sailors plan ocean crossings. Since then, choosing a retirement date, keeping track of equipment, and tending a garden have each given the workshop a reason to build something new.</p>
      <p class="principle" id="principles">The workshop favors local-first software. Wherever practical, you can open a tool, work through a question, and keep the results on your own device without creating an account.</p>
    </section>
    <section class="directory" id="products" aria-labelledby="directory-title">
      <h2 id="directory-title">Software from the workshop</h2>
      <ul>
        {products.map(({name, job, url, accent}) => (
          <li>
            <a class="product" href={url} style={`--accent: ${accent}`}>
              <h3>{name}</h3>
              <p>{job}</p>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Workshop>
